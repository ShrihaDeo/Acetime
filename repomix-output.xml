@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Inter:wght@300;400;500&display=swap');

/* ─── Variables ──────────────────────────────────────────────── */
:root {
  --neon-blue:    #00d4ff;
  --neon-purple:  #b44dff;
  --neon-pink:    #ff3dac;
  --neon-green:   #00ffb3;
  --neon-gold:    #ffd700;
  --bg-void:      #050508;
  --bg-deep:      #08080f;
  --bg-surface:   #0f0f1a;
  --bg-raised:    #161625;
  --bg-glass:     rgba(255,255,255,0.04);
  --glass-border: rgba(255,255,255,0.08);
  --glass-border-bright: rgba(255,255,255,0.18);
  --text-primary: #f0eeff;
  --text-muted:   #6b6880;
  --radius-sm:    12px;
  --radius-md:    18px;
  --radius-lg:    26px;
  --radius-xl:    36px;
}

/* ─── Reset ──────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Inter', sans-serif;
  background: var(--bg-void);
  color: var(--text-primary);
  min-height: 100vh;
  overflow-x: hidden;
}

#root { height: 100vh; width: 100%; }

/* ─── Animated mesh background ───────────────────────────────── */
.mesh-bg {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

/* big slow-moving orbs */
/* Multiple radial gradients layered and animated with @keyframes to create a living, breathing colour field behind the UI. */
.mesh-bg::before {
  content: '';
  position: absolute;
  inset: -50%;
  background:
    radial-gradient(ellipse 55% 45% at 15% 20%, rgba(180,77,255,0.22) 0%, transparent 60%),
    radial-gradient(ellipse 50% 40% at 85% 75%, rgba(0,212,255,0.18) 0%, transparent 60%),
    radial-gradient(ellipse 40% 35% at 50% 50%, rgba(255,61,172,0.10) 0%, transparent 60%),
    radial-gradient(ellipse 60% 50% at 80% 10%, rgba(0,255,179,0.08) 0%, transparent 60%);
  animation: mesh-drift 18s ease-in-out infinite alternate;
}

.mesh-bg::after {
  content: '';
  position: absolute;
  inset: -50%;
  background:
    radial-gradient(ellipse 45% 40% at 70% 30%, rgba(255,215,0,0.07) 0%, transparent 55%),
    radial-gradient(ellipse 55% 45% at 25% 80%, rgba(180,77,255,0.12) 0%, transparent 60%),
    radial-gradient(ellipse 35% 30% at 90% 60%, rgba(0,212,255,0.10) 0%, transparent 50%);
  animation: mesh-drift 24s ease-in-out infinite alternate-reverse;
}

@keyframes mesh-drift {
  0%   { transform: translate(0,0) scale(1); }
  33%  { transform: translate(3%, 4%) scale(1.04); }
  66%  { transform: translate(-4%, 2%) scale(0.97); }
  100% { transform: translate(2%, -3%) scale(1.02); }
}

/* grid overlay */
.grid-overlay {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
  background-size: 60px 60px;
  mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);
}

/* floating particles */
.particles {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.particle {
  position: absolute;
  border-radius: 50%;
  animation: particle-float linear infinite;
  opacity: 0;
}

@keyframes particle-float {
  0%   { transform: translateY(110vh) scale(0); opacity: 0; }
  5%   { opacity: 1; }
  95%  { opacity: 0.6; }
  100% { transform: translateY(-10vh) scale(1.5); opacity: 0; }
}

/* suit watermark bg */
.suits-bg {
  position: fixed;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}

.suit {
  position: absolute;
  font-size: 320px;
  user-select: none;
  line-height: 1;
  animation: suit-breathe 8s ease-in-out infinite;
}

@keyframes suit-breathe {
  0%, 100% { opacity: var(--base-op, 0.04); transform: var(--base-rot) scale(1); }
  50%       { opacity: calc(var(--base-op, 0.04) * 1.6); transform: var(--base-rot) scale(1.03); }
}

.suit:nth-child(1) {
  top: -80px; left: -80px;
  --base-rot: rotate(-18deg); --base-op: 0.05;
  color: var(--neon-purple);
  filter: drop-shadow(0 0 40px rgba(180,77,255,0.3));
  animation-delay: 0s;
}
.suit:nth-child(2) {
  top: -80px; right: -80px;
  --base-rot: rotate(18deg); --base-op: 0.04;
  color: var(--neon-blue);
  filter: drop-shadow(0 0 40px rgba(0,212,255,0.25));
  animation-delay: 2s;
}
.suit:nth-child(3) {
  bottom: -80px; left: -80px;
  --base-rot: rotate(12deg); --base-op: 0.05;
  color: var(--neon-pink);
  filter: drop-shadow(0 0 40px rgba(255,61,172,0.25));
  animation-delay: 4s;
}
.suit:nth-child(4) {
  bottom: -80px; right: -80px;
  --base-rot: rotate(-12deg); --base-op: 0.04;
  color: var(--neon-green);
  filter: drop-shadow(0 0 40px rgba(0,255,179,0.2));
  animation-delay: 6s;
}

/* ─── Noise grain overlay ────────────────────────────────────── */
.noise {
  position: fixed;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  opacity: 0.025;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 180px;
}

/* ─── Glass card ─────────────────────────────────────────────── */
/* Frosted glass UI effect using backdrop blur and semitransparent background */
.glass-card {
  background: rgba(15,15,26,0.7);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  box-shadow:
    0 0 0 1px rgba(255,255,255,0.03),
    0 32px 80px rgba(0,0,0,0.7),
    inset 0 1px 0 rgba(255,255,255,0.07);
}

/* ─── Neon button ────────────────────────────────────────────── */
button {
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  font-weight: 500;
  cursor: pointer;
  border: none;
  transition: all 0.2s ease;
}

.btn-neon {
  position: relative;
  padding: 16px 48px;
  border-radius: 980px;
  background: linear-gradient(135deg, var(--neon-purple) 0%, var(--neon-blue) 100%);
  color: white;
  font-weight: 600;
  font-size: 16px;
  letter-spacing: 0.3px;
  border: none;
  box-shadow:
    0 0 30px rgba(180,77,255,0.4),
    0 0 60px rgba(0,212,255,0.15),
    0 8px 24px rgba(0,0,0,0.5);
  overflow: hidden;
}
.btn-neon::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, transparent 60%);
  border-radius: inherit;
}
.btn-neon:hover {
  transform: translateY(-3px) scale(1.02);
  box-shadow:
    0 0 50px rgba(180,77,255,0.55),
    0 0 100px rgba(0,212,255,0.2),
    0 16px 40px rgba(0,0,0,0.6);
}
.btn-neon:active { transform: translateY(-1px) scale(1); }

/* ─── Inputs ─────────────────────────────────────────────────── */
.fancy-input {
  width: 100%;
  padding: 15px 20px;
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  color: var(--text-primary);
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
}
.fancy-input::placeholder { color: var(--text-muted); }
.fancy-input:focus {
  border-color: rgba(180,77,255,0.5);
  background: rgba(255,255,255,0.07);
  box-shadow: 0 0 0 3px rgba(180,77,255,0.12), 0 0 20px rgba(180,77,255,0.08);
}

.input-label {
  font-size: 11px;
  font-weight: 500;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1.2px;
  margin-bottom: 7px;
  display: block;
}

/* ─── Landing Page ───────────────────────────────────────────── */
.landing-page {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  text-align: center;
  padding: 40px;
  gap: 0;
}

.landing-eyebrow {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--neon-blue);
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.landing-eyebrow::before,
.landing-eyebrow::after {
  content: '';
  width: 30px; height: 1px;
  background: linear-gradient(90deg, transparent, var(--neon-blue));
}
.landing-eyebrow::after {
  background: linear-gradient(90deg, var(--neon-blue), transparent);
}

.landing-title {
  font-family: 'Syne', sans-serif;
  font-size: clamp(56px, 9vw, 100px);
  font-weight: 800;
  line-height: 0.95;
  letter-spacing: -3px;
  margin-bottom: 24px;
}

.landing-title .line1 { color: var(--text-primary); display: block; }
.landing-title .line2 {
  display: block;
  background: linear-gradient(90deg, var(--neon-purple) 0%, var(--neon-blue) 40%, var(--neon-pink) 80%, var(--neon-purple) 100%);
  background-size: 200% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: shimmer 4s linear infinite;
}

@keyframes shimmer {
  0%   { background-position: 0% center; }
  100% { background-position: 200% center; }
}

.landing-sub {
  font-size: 17px;
  font-weight: 300;
  color: var(--text-muted);
  line-height: 1.6;
  max-width: 440px;
  margin-bottom: 44px;
}

.landing-sub strong {
  color: rgba(240,238,255,0.7);
  font-weight: 400;
}

.landing-cta-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  margin-bottom: 60px;
}

.landing-hint {
  font-size: 12px;
  color: var(--text-muted);
}

.landing-stats {
  display: flex;
  gap: 0;
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: var(--bg-glass);
  backdrop-filter: blur(12px);
}

.stat-item {
  padding: 16px 28px;
  text-align: center;
  border-right: 1px solid var(--glass-border);
}
.stat-item:last-child { border-right: none; }
.stat-num {
  font-family: 'Syne', sans-serif;
  font-size: 20px;
  font-weight: 700;
  display: block;
}
.stat-num.blue   { color: var(--neon-blue); }
.stat-num.purple { color: var(--neon-purple); }
.stat-num.pink   { color: var(--neon-pink); }
.stat-label {
  font-size: 11px;
  color: var(--text-muted);
  margin-top: 2px;
  display: block;
}

/* logo float */
.landing-logo {
  width: 80px;
  margin-bottom: 20px;
  filter:
    drop-shadow(0 0 20px rgba(180,77,255,0.6))
    drop-shadow(0 0 60px rgba(0,212,255,0.3));
  animation: logo-float 5s ease-in-out infinite;
}
@keyframes logo-float {
  0%, 100% { transform: translateY(0) rotate(-2deg); }
  50%       { transform: translateY(-10px) rotate(2deg); }
}

/* ─── Room Page ──────────────────────────────────────────────── */
.room-page {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 24px;
}

.room-card {
  width: 100%;
  max-width: 440px;
  padding: 48px 44px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.room-card-header {
  text-align: center;
  margin-bottom: 4px;
}

.room-card-icon {
  font-size: 44px;
  display: block;
  margin-bottom: 16px;
  filter: drop-shadow(0 0 20px rgba(180,77,255,0.5));
  animation: logo-float 4s ease-in-out infinite;
}

.room-card-title {
  font-family: 'Syne', sans-serif;
  font-size: 30px;
  font-weight: 800;
  letter-spacing: -1px;
  background: linear-gradient(135deg, var(--text-primary) 40%, rgba(180,77,255,0.8) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 8px;
}

.room-card-sub {
  font-size: 13px;
  color: var(--text-muted);
}

/* neon divider */
.neon-divider {
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--neon-purple), var(--neon-blue), transparent);
  border: none;
  opacity: 0.5;
  margin: 4px 0;
}

.input-group { display: flex; flex-direction: column; gap: 7px; }

.room-join-btn {
  width: 100%;
  padding: 16px;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, var(--neon-purple) 0%, var(--neon-blue) 100%);
  color: white;
  font-weight: 600;
  font-size: 15px;
  letter-spacing: 0.3px;
  border: none;
  cursor: pointer;
  box-shadow: 0 0 24px rgba(180,77,255,0.35), 0 0 48px rgba(0,212,255,0.1);
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
  margin-top: 4px;
}
.room-join-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.12) 0%, transparent 60%);
}
.room-join-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 0 40px rgba(180,77,255,0.5), 0 0 80px rgba(0,212,255,0.15);
}

.error-msg {
  font-size: 13px;
  color: #ff6b8a;
  background: rgba(255,61,172,0.08);
  border: 1px solid rgba(255,61,172,0.2);
  border-radius: 8px;
  padding: 10px 14px;
  text-align: center;
}

.room-footer-hint {
  font-size: 12px;
  color: var(--text-muted);
  text-align: center;
}

/* ─── Call Screen ────────────────────────────────────────────── */
.call-screen {
  display: flex;
  height: 100vh;
  width: 100%;
  position: relative;
  z-index: 2;
}

/* left video panel */
.left-panel {
  width: 40%;
  background: rgba(5,5,8,0.95);
  display: flex;
  flex-direction: column;
  padding: 14px;
  gap: 10px;
  box-sizing: border-box;
  border-right: 1px solid var(--glass-border);
  backdrop-filter: blur(20px);
}

/* room strip */
.room-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 9px 14px;
  background: var(--bg-glass);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.room-strip-label {
  font-size: 10px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1.2px;
}
.room-strip-id {
  font-family: 'Syne', sans-serif;
  font-size: 14px;
  font-weight: 700;
  color: var(--neon-blue);
  letter-spacing: 2px;
  text-shadow: 0 0 12px rgba(0,212,255,0.5);
}
.room-strip-copy {
  font-size: 11px;
  color: var(--text-muted);
  cursor: pointer;
  padding: 4px 10px;
  border-radius: 20px;
  border: 1px solid var(--glass-border);
  background: transparent;
  margin-top: 0;
  transition: all 0.15s;
  font-family: 'Inter', sans-serif;
}
.room-strip-copy:hover { color: var(--neon-blue); border-color: rgba(0,212,255,0.3); }
.room-strip-copy.copied { color: var(--neon-green); border-color: rgba(0,255,179,0.3); }

/* video container */
.video-container {
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: 10px;
  min-height: 0;
}

.main-video {
  position: relative;
  flex: 1;
  min-height: 0;
  background: #05050a;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 1px solid var(--glass-border);
  box-shadow: inset 0 0 40px rgba(0,0,0,0.5);
}

.self-view {
  position: relative;
  height: 120px;
  background: #05050a;
  border-radius: var(--radius-sm);
  overflow: hidden;
  border: 1px solid var(--glass-border);
  flex-shrink: 0;
}

.video-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: linear-gradient(135deg, #08080f, #0f0820);
  color: var(--text-muted);
  font-size: 13px;
  z-index: 2;
}

.waiting-pulse {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--neon-purple);
  box-shadow: 0 0 12px var(--neon-purple);
  animation: pulse 1.4s ease-in-out infinite;
}
@keyframes pulse {
  0%,100% { opacity:1; transform:scale(1); }
  50%      { opacity:0.3; transform:scale(0.6); }
}

/* name tag */
.name-tag {
  position: absolute;
  bottom: 10px; left: 10px;
  background: rgba(5,5,8,0.8);
  color: var(--text-primary);
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 500;
  backdrop-filter: blur(10px);
  border: 1px solid var(--glass-border);
  pointer-events: none;
  z-index: 10;
}

/* controls bar */
.controls-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 2px;
  flex-shrink: 0;
}
.controls-left, .controls-right { display: flex; gap: 8px; }

.control-btn {
  width: 46px; height: 46px;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--bg-raised);
  border: 1px solid var(--glass-border);
  cursor: pointer;
  transition: all 0.18s ease;
  margin-top: 0;
  box-shadow: none;
}
.control-btn:hover {
  background: var(--bg-surface);
  border-color: var(--glass-border-bright);
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(0,0,0,0.4);
}
.control-btn img {
  width: 18px; height: 18px;
  filter: invert(1) opacity(0.65);
}
.control-btn.active {
  background: rgba(255,61,172,0.2);
  border-color: rgba(255,61,172,0.4);
  box-shadow: 0 0 16px rgba(255,61,172,0.25);
}
.control-btn.active img { filter: invert(1) opacity(0.9); }

.end-call {
  background: linear-gradient(135deg, #c0392b, #e74c3c) !important;
  border-color: transparent !important;
  box-shadow: 0 0 20px rgba(192,57,43,0.4) !important;
}
.end-call:hover {
  box-shadow: 0 0 35px rgba(192,57,43,0.6) !important;
  transform: translateY(-2px) !important;
}

/* ─── Right game panel ───────────────────────────────────────── */
.right-panel {
  width: 60%;
  position: relative;
  overflow: hidden;
  transition: background 0.6s ease;
}

/* dot grid on game table */
.right-panel::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle, rgba(255,255,255,0.07) 1px, transparent 1px);
  background-size: 28px 28px;
  pointer-events: none;
  z-index: 0;
}

.table-suits {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}
.table-suit {
  position: absolute;
  font-size: 400px;
  opacity: 0.06;
  user-select: none;
  line-height: 1;
  filter: blur(1px);
}
.table-suit:nth-child(1) { top: -80px; left: -60px; transform: rotate(-15deg); }
.table-suit:nth-child(2) { bottom: -80px; right: -60px; transform: rotate(15deg); }

.corner {
  position: absolute;
  width: 44px; height: 44px;
  pointer-events: none;
  opacity: 0.4;
  z-index: 1;
}
.corner.tl { top:18px; left:18px; border-top:2px solid; border-left:2px solid; border-radius:8px 0 0 0; }
.corner.tr { top:18px; right:18px; border-top:2px solid; border-right:2px solid; border-radius:0 8px 0 0; }
.corner.bl { bottom:18px; left:18px; border-bottom:2px solid; border-left:2px solid; border-radius:0 0 0 8px; }
.corner.br { bottom:18px; right:18px; border-bottom:2px solid; border-right:2px solid; border-radius:0 0 8px 0; }

.game-area {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
  padding: 22px 26px;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.game-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 6px 14px;
  border-radius: 20px;
  background: rgba(0,0,0,0.4);
  border: 1px solid var(--glass-border);
  font-size: 12px;
  backdrop-filter: blur(8px);
}
.status-dot {
  width: 5px; height: 5px;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 6px currentColor;
}

.bg-cycle-btn {
  padding: 6px 16px;
  background: rgba(0,0,0,0.35);
  border: 1px solid var(--glass-border);
  color: rgba(255,255,255,0.55);
  border-radius: 20px;
  font-size: 11px;
  cursor: pointer;
  backdrop-filter: blur(8px);
  margin-top: 0;
  box-shadow: none;
  transition: all 0.15s;
  font-family: 'Inter', sans-serif;
  letter-spacing: 0.3px;
}
.bg-cycle-btn:hover { color: white; border-color: var(--glass-border-bright); }

.hand-label {
  font-size: 10px;
  color: rgba(255,255,255,0.3);
  text-transform: uppercase;
  letter-spacing: 1.5px;
  text-align: center;
  margin-bottom: 8px;
}

.opponent-hand, .player-hand {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  justify-content: center;
}
.opponent-hand { padding-top: 8px; }
.player-hand   { padding-bottom: 8px; }

.game-table {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.discard-label {
  font-size: 10px;
  color: rgba(255,255,255,0.3);
  text-transform: uppercase;
  letter-spacing: 1.5px;
}

.card-placeholder {
  width: 76px; height: 114px;
  background: rgba(255,255,255,0.03);
  border-radius: 10px;
  border: 2px dashed rgba(255,255,255,0.1);
  display: flex; align-items: center; justify-content: center;
  color: rgba(255,255,255,0.15);
  font-size: 11px;
}

/* ─── Playing Cards ──────────────────────────────────────────── */
.card {
  width: 76px; height: 114px;
  background: linear-gradient(145deg, #ffffff, #f5f0ff);
  border-radius: 10px;
  position: relative;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 6px 20px rgba(0,0,0,0.6),
    0 1px 0 rgba(255,255,255,0.9) inset,
    0 0 0 1px rgba(0,0,0,0.15);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  user-select: none;
}
.card:hover:not(.card-disabled) {
  transform: translateY(-16px) scale(1.05) rotate(-1deg);
  box-shadow:
    0 20px 40px rgba(0,0,0,0.7),
    0 0 30px rgba(180,77,255,0.25),
    0 1px 0 rgba(255,255,255,0.9) inset;
}
.card-red   { color: #d63031; }
.card-black { color: #1a1a2e; }
.card-disabled { opacity: 0.4; cursor: not-allowed; }
.card-disabled:hover { transform: none !important; box-shadow: 0 6px 20px rgba(0,0,0,0.6), 0 1px 0 rgba(255,255,255,0.9) inset; }

.card-corner {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 12px;
  font-weight: 800;
  line-height: 1.1;
  font-family: 'Syne', sans-serif;
}
.card-corner.top-left    { top:5px; left:7px; }
.card-corner.bottom-right{ bottom:5px; right:7px; transform:rotate(180deg); }
.card-center { font-size: 28px; }

.card-back {
  background: linear-gradient(135deg, #0d0820 0%, #1a0f35 50%, #0d0820 100%);
  border: 1px solid rgba(180,77,255,0.25);
  box-shadow:
    0 6px 20px rgba(0,0,0,0.6),
    inset 0 0 30px rgba(180,77,255,0.08),
    0 0 0 1px rgba(0,0,0,0.3);
  cursor: default;
  overflow: hidden;
  position: relative;
}
.card-back::before {
  content: '';
  position: absolute;
  inset: 4px;
  border: 1px solid rgba(180,77,255,0.15);
  border-radius: 7px;
}
.card-back::after {
  content: '✦';
  position: absolute;
  font-size: 28px;
  color: rgba(180,77,255,0.3);
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  text-shadow: 0 0 20px rgba(180,77,255,0.5);
}
